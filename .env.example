# ================================
# RDCM HYBRID PLATFORM - PRODUCTION
# Environment Variables Template
# ================================

# Server
PORT=3001
NODE_ENV=production

# ================================
# MINING (Unmineable)
# ================================
UNMINEABLE_API_KEY=your_unmineable_id
UNMINEABLE_USER_ID=your_unmineable_user_id

# ================================
# CRYPTO EXCHANGE (Coinbase)
# ================================
COINBASE_API_KEY=your_coinbase_api_key
COINBASE_API_SECRET=your_coinbase_api_secret
COINBASE_PASSPHRASE=your_coinbase_passphrase

# ================================
# STOCK TRADING (Robinhood)
# ================================
ROBINHOOD_USERNAME=your_robinhood_email
ROBINHOOD_PASSWORD=your_robinhood_password
ROBINHOOD_MFA=your_mfa_device_id
ROBINHOOD_TOKEN=your_robinhood_bearer_token

# ================================
# AI SIGNALS (Claude)
# ================================
CLAUDE_API_KEY=your_claude_api_key

# ================================
# MARKET DATA (NewsAPI)
# ================================
NEWS_API_KEY=your_newsapi_key

# ================================
# TRADING SETTINGS
# ================================
TRADING_STRATEGY=balanced
MIN_SIGNAL_CONFIDENCE=60
MAX_POSITION_SIZE=0.02
TRADING_HOURS_START=09:00
TRADING_HOURS_END=17:00
TRADING_DAYS=1,2,3,4,5

# ================================
# PORTFOLIO ALLOCATION (%)
# ================================
CONSERVATIVE_ALLOCATION=AAPL:40,JNJ:30,KO:30
BALANCED_ALLOCATION=AAPL:30,MSFT:30,AMZN:20,TSLA:20
AGGRESSIVE_ALLOCATION=TSLA:30,NVDA:30,AAPL:20,AMD:20

# ================================
# AUTOMATION SCHEDULE (24-hour format)
# ================================
EARNINGS_CHECK_TIME=09:00
CONVERSION_TIME=10:00
SIGNAL_GENERATION_TIME=10:30
TRADE_EXECUTION_TIME=11:00
REBALANCE_TIME=15:00
METRICS_TIME=16:00

# ================================
# DATABASE (Optional - for future use)
# ================================
DATABASE_URL=optional_database_url
