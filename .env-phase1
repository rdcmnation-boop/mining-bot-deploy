# ==================== RDCM HYBRID PLATFORM - PHASE 1 ====================
# Real Mining Backend with Unmineable Integration

# Server
NODE_ENV=production
PORT=3001

# ==================== UNMINEABLE API ====================
# Get API access from: https://app.unmineable.com/dashboard
# No API key needed - wallet address is public on Unmineable

UNMINEABLE_API_BASE=https://api.unmineable.com/v4

# Example wallets (replace with real wallets):
# These are just examples - users will link their own wallets
EXAMPLE_DOGE_WALLET=1A1z7agoat2YLZW51Cc87l1L1xvsmmWnhm
EXAMPLE_BTC_WALLET=1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa
EXAMPLE_ETH_WALLET=0x32Be343B94f860124dC4fEe278FADBD03915aBe6

# ==================== AUTHENTICATION ====================
JWT_SECRET=rdcm-hybrid-platform-secret-key-change-in-production
JWT_EXPIRES_IN=30d

# ==================== CORS ====================
CORS_ORIGIN=*

# ==================== LOGGING ====================
LOG_LEVEL=info
ENABLE_AUDIT_LOGGING=true

# ==================== RATE LIMITING ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ==================== PHASE 1 FEATURES ====================
FEATURE_REAL_MINING=true
FEATURE_TRADING=false
FEATURE_AI_AGENTS=false

# Mining refresh interval (seconds)
MINING_STATS_REFRESH=30

# ==================== PLANNED FOR FUTURE PHASES ====================
# PHASE 2: Trading
# ROBINHOOD_CLIENT_ID=your_robinhood_client_id
# ROBINHOOD_CLIENT_SECRET=your_robinhood_client_secret
# ROBINHOOD_REDIRECT_URI=https://your-domain.com/auth/robinhood

# PHASE 3: AI Trading
# CLAUDE_API_KEY=your_claude_api_key
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key
# IEX_CLOUD_KEY=your_iex_cloud_key

# Database (when ready to migrate from in-memory)
# DATABASE_URL=postgres://user:pass@localhost:5432/rdcm_hybrid
